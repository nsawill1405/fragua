local cache = nil

function IconData.list()
	if cache then
		return cache
	end
	local icons = {}
	local seen = {}
	for _, category in { "World", "Characters", "UI", "Effects", "Audio", "Networking", "Values", "Services" } do
		for _, className in GROUPS[category] do
			local id = "class_" .. className
			if not seen[id] then
				seen[id] = true
				table.insert(icons, {
					id = id,
					label = className,
					kind = "class",
					className = className,
					category = category,
					fallback = string.upper(className:sub(1, 1)),
				})
			end
		end
	end
	cache = icons
	return icons
end

return IconData
